{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "dist/ts.tsbuildinfo",
    "paths": {
      "#app/*": ["./src/app/*"],
      "#routed/*": ["./src/app/modules/routed/*"],
      "#service/*": ["./src/app/modules/service/*"],
      "@holu/core": ["../../packages/core/src/index.js"],
      "@holu/rest": ["../../packages/rest/src/index.js"],
      "@holu/openapi": ["../../packages/openapi/src/index.js"],
      "@holu/jwt": ["../../packages/jwt/src/index.js"],
      "@holu/rest-testing": ["../../packages/rest-testing/src/index.js"],
    }
  },
  "include": ["src", "e2e"],
  "references": [
    { "path": "../../packages/core/tsconfig.build.json" },
    { "path": "../../packages/cli/tsconfig.build.json" },
    { "path": "../../packages/openapi/tsconfig.build.json" },
    { "path": "../../packages/rest/tsconfig.build.json" },
    { "path": "../../packages/jwt/tsconfig.build.json" },
    { "path": "../../packages/rest-testing/tsconfig.build.json" },
  ]
}
