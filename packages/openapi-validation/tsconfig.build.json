{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/build.tsbuildinfo",
    "paths": {
      "@holu/core": ["../core/src"],
      "@holu/body-parser": ["../body-parser/src"],
      "@holu/openapi": ["../openapi/src"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.spec.ts"],
  "files": [],
  "references": [
    { "path": "../core/tsconfig.build.json" },
    { "path": "../body-parser/tsconfig.build.json" },
    { "path": "../openapi/tsconfig.build.json" },
  ]
}
