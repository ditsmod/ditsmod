{
  "name": "@holu/rest-testing",
  "type": "module",
  "version": "3.0.0-next.18",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holu/holu.git"
  },
  "description": "Holu module to support testing for @holu/rest module",
  "module": "dist/index.js",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#app/*": "./dist/*"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "rm -rf dist*",
    "test": "tsc -b tsconfig.unit.json && yarn esm-jest",
    "esm-jest": "yarn node --experimental-vm-modules --no-warnings=ExperimentalWarning --enable-source-maps ../../scripts/run-jest.mjs"
  },
  "keywords": [
    "holu",
    "testing"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "@holu/core": "^3.0.0-next.18",
    "@holu/rest": "^3.0.0-next.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "gitHead": "eaf8f20b4e75e38c7a51fd1c3174b691cea756fa"
}
