{
  "name": "@holu/body-parser",
  "type": "module",
  "version": "3.0.0-next.18",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holu/holu.git"
  },
  "description": "Body parser module for Holu applications",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "rm -rf dist*",
    "test": "tsc -b tsconfig.unit.json && yarn esm-jest",
    "esm-jest": "yarn node --experimental-vm-modules --no-warnings=ExperimentalWarning --enable-source-maps ../../scripts/run-jest.mjs"
  },
  "keywords": [
    "holu"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ts-stack/body-parser": "^1.2.1",
    "@ts-stack/multer": "^1.0.1"
  },
  "peerDependencies": {
    "@holu/core": "^3.0.0-next.18",
    "@holu/rest": "^3.0.0-next.18"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "gitHead": "eaf8f20b4e75e38c7a51fd1c3174b691cea756fa"
}
